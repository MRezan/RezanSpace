# Use the exact production origin consistently (HTTPS requires a valid domain certificate).
NEXT_PUBLIC_SITE_URL=https://rezan.space
NEXT_PUBLIC_API_URL=https://rezan.space
# API used during static builds; can point to a local PHP backend.
REZAN_BUILD_API_URL=http://127.0.0.1:8000
# Optional: JSON array of published posts, exported from your own backend.
# REZAN_POSTS_FILE=/absolute/path/to/published-posts.json
